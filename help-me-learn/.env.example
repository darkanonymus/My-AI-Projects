# Copy this file to ".env" and fill in what you need.

# ---- Gemini 2.5 Flash (NEW — recommended: free tier, best reasoning + vision) ----
# Free: 1500 requests/day, 1M token context, native multimodal (text + images)
# Get your key: https://ai.google.dev/
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ---- Claude (optional — if you want premium quality) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Ollama (DEPRECATED — replaced by Gemini free tier) ----
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ---- Default engine when the app first loads: gemini | claude | ollama ----
DEFAULT_PROVIDER=gemini

# ---- Server port (optional) ----
PORT=8000

# ---- Deployment (see deploy/README.md) ----
# Public domain for automatic HTTPS when self-hosting (e.g. a free DuckDNS name
# pointing at your Oracle Always Free VM). Only needed for deploy/docker-compose.
DOMAIN=
# HML_DB=/data/data.db   # set automatically in the container; leave unset locally
