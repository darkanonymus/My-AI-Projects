# Secrets — never commit real keys, use .env.example as the template
.env

# Python
.venv/
__pycache__/
*.pyc

# Local data — personal generated courses, not project source
# (the -wal/-shm sidecars appear once SQLite runs in WAL mode)
data.db
data.db-wal
data.db-shm

# TTS — downloaded voice models (~60 MB each) + synthesized audio cache
voices/
.tts_cache/

# Editor/agent local state
.claude/settings.local.json
.agents/

# Backup files from refactors (git history is the safety net now)
*.bak
